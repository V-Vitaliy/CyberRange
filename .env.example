#==========================================

#DataBases(State Server - t3.micro)

#==========================================

# Docker Compose database credentials. If changed, update DATABASE_URL too.
POSTGRES_USER=cyberadmin
POSTGRES_PASSWORD=cyberpassword123
POSTGRES_DB=cyberrange
# Backend connection URLs. Use the State Server address for a split deployment.
DATABASE_URL=postgresql+asyncpg://cyberadmin:cyberpassword123@localhost:5432/cyberrange
# Seed: python scripts/admin_setup.py --lab-id <stable UUID>
# Passwords are prompted securely, or supplied as RED_TEAM_PASSWORD and
# BLUE_TEAM_PASSWORD in the process environment (not read from this .env).
# Existing passwords and game state are preserved. See LOCAL_RUN.md.

REDIS_URL=redis://localhost:6379

#==========================================
#
# Storage and Vectors (Compute Server - Spot)
#
#==========================================

MINIO_ROOT_USER=admin_minio
MINIO_ROOT_PASSWORD=supersecret_minio
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET_NAME=student-uploads

CHROMA_HOST=localhost
CHROMA_PORT=8000

#==========================================
#
# Security
#
#==========================================


JWT_SECRET=replace_this_with_a_long_random_string_in_production
JWT_ALGORITHM=HS256

#==========================================
# Optional LLM and email integrations
#==========================================

# Empty selects the local LLM; set a key to select Groq.
GROQ_API_KEY=
# Local model path is resolved relative to backend/app/core.
LLM_MODEL_PATH=../../models/Meta-Llama-3-8B.Q4_K_M.gguf

# Empty SMTP_HOST uses the existing email mock and sends no real email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
