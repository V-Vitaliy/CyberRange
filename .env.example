#==========================================

#DataBases(State Server - t3.micro)

#==========================================

# Docker Compose refuses to start until the passwords below are set.
# Generate each one with: openssl rand -hex 24
POSTGRES_USER=cyberadmin
POSTGRES_PASSWORD=
POSTGRES_DB=cyberrange
REDIS_PASSWORD=
# Address the state services are published on. Keep 127.0.0.1 unless the backend
# runs on another host; then use a private address that lab users cannot reach.
STATE_BIND_ADDRESS=127.0.0.1
# Backend connection URLs: replace the <...> placeholders with the passwords above.
# Use the State Server address for a split deployment.
DATABASE_URL=postgresql+asyncpg://cyberadmin:<POSTGRES_PASSWORD>@localhost:5432/cyberrange
# Explicit JSON map of lab UUIDs to restricted reader URLs. Empty disables SQLi
# search; DATABASE_URL is never used to execute injectable SQL. See LOCAL_RUN.md.
SQLI_CONNECTIONS_FILE=
# Seed: python scripts/admin_setup.py --lab-id <stable UUID>
# Passwords are prompted securely, or supplied as RED_TEAM_PASSWORD and
# BLUE_TEAM_PASSWORD in the process environment (not read from this .env).
# Existing passwords and game state are preserved. See LOCAL_RUN.md.

REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379/0

#==========================================
#
# Storage and Vectors (Compute Server - Spot)
#
#==========================================

# Chroma has no built-in authentication; keep it reachable only by the backend.
COMPUTE_BIND_ADDRESS=127.0.0.1
CHROMA_HOST=localhost
CHROMA_PORT=8000

#==========================================
#
# Security
#
#==========================================


# Required, at least 32 bytes. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256

#==========================================
# Optional LLM and email integrations
#==========================================

# Empty provider preserves automatic selection: Groq key, otherwise GGUF.
LLM_PROVIDER=
# Set LLM_PROVIDER=openai_compatible for the local HTTP inference server.
# Required for this provider: server base URL ending in /v1 and its model ID.
LLM_BASE_URL=
LLM_MODEL=
# May stay empty for a local server without authentication.
LLM_API_KEY=
# Total output budget for the HTTP provider, including model reasoning.
LLM_MAX_TOKENS=2048
GROQ_API_KEY=
# Local model path is resolved relative to backend/app/core.
LLM_MODEL_PATH=../../models/Meta-Llama-3-8B.Q4_K_M.gguf

# Empty SMTP_HOST uses the existing email mock and sends no real email.
# For the local Mailpit sink: SMTP_HOST=localhost, SMTP_PORT=1025, SMTP_STARTTLS=false.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=assistant@lab.local
# The agent may only email these comma-separated domains when SMTP_HOST is set.
EMAIL_ALLOWED_DOMAINS=lab.local

# Browser origins allowed to call the API (JSON list).
FRONTEND_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
